{
  "name": "@niubu-internal/node-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@niubu-internal/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:",
    "@niubu-internal/test-config": "workspace:*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "vitest run"
  },
  "niubu": {
    "test": {
      "include": [
        "src/**/*.{test,spec}.ts"
      ]
    }
  },
  "dependencies": {
    "@niubu/core-shared": "workspace:*"
  }
}
