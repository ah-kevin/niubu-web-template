{
  "name": "@niubu/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./chart": "./src/chart/index.ts",
    "./csv": "./src/csv/index.ts"
  },
  "dependencies": {
    "@niubu/shadcn-ui": "workspace:*",
    "@niubu/core-typings": "workspace:*",
    "recharts": "catalog:",
    "react-is": "catalog:",
    "papaparse": "catalog:"
  },
  "devDependencies": {
    "@niubu-internal/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@types/react": "catalog:",
    "vite": "catalog:",
    "@niubu-internal/test-config": "workspace:*",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/papaparse": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "niubu": {
    "test": {
      "include": [
        "src/**/*.{test,spec}.{ts,tsx}"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../../eslint.config.js",
    "test": "vitest run"
  }
}
