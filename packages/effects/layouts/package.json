{
  "name": "@niubu/layouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./routing": "./src/routing/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./widgets/styles.css": "./src/widgets/styles.css",
    "./routing/styles.css": "./src/routing/styles.css"
  },
  "dependencies": {
    "@niubu/layout-ui": "workspace:*",
    "@niubu/menu-ui": "workspace:*",
    "@niubu/preferences": "workspace:*",
    "@niubu/locales": "workspace:*",
    "@niubu/stores": "workspace:*",
    "@niubu/common-ui": "workspace:*",
    "@niubu/hooks": "workspace:*",
    "@niubu/icons": "workspace:*",
    "@niubu/core-shared": "workspace:*",
    "@niubu/core-typings": "workspace:*",
    "@niubu/tabs-ui": "workspace:*",
    "@niubu/shadcn-ui": "workspace:*",
    "react-router-dom": "catalog:",
    "@niubu/core-preferences": "workspace:*"
  },
  "devDependencies": {
    "@niubu-internal/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@types/react": "catalog:",
    "vite": "catalog:",
    "@niubu-internal/test-config": "workspace:*",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "niubu": {
    "test": {
      "include": [
        "src/**/*.{test,spec}.{ts,tsx}"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../../eslint.config.js",
    "test": "vitest run"
  }
}
