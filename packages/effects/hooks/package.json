{
  "name": "@niubu/hooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme-dom": "./src/theme-dom.ts",
    "./storage": "./src/storage.ts"
  },
  "sideEffects": false,
  "devDependencies": {
    "@niubu-internal/tsconfig": "workspace:*",
    "@niubu-internal/test-config": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:"
  },
  "niubu": {
    "test": {
      "include": [
        "src/**/*.{test,spec}.{ts,tsx}"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../../eslint.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@niubu/core-design": "workspace:*",
    "@niubu/core-preferences": "workspace:*"
  }
}
