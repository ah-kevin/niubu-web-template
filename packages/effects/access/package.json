{
  "name": "@niubu/access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "dependencies": {
    "@niubu/core-typings": "workspace:*"
  },
  "devDependencies": {
    "@niubu-internal/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@types/react": "catalog:",
    "vite": "catalog:",
    "@niubu-internal/test-config": "workspace:*",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:"
  },
  "sideEffects": false,
  "niubu": {
    "test": {
      "include": [
        "src/**/*.{test,spec}.{ts,tsx}"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../../eslint.config.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
